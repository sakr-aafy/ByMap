# .env — Variables d'environnement ByMap Backend
# Copier ce fichier en .env et adapter les valeurs

# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=*

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/bymap
# Exemple Atlas : MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/bymap

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=bymap_super_secret_change_in_production
JWT_REFRESH_SECRET=bymap_refresh_secret_change_in_production
JWT_EXPIRES=7d

# ─── Compte Admin ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@admin.tn
ADMIN_PASSWORD=admin123

# ─── SMTP Gmail (vérification email) ──────────────────────────────────────────
# Activer "Mots de passe d'application" sur votre compte Google :
# https://myaccount.google.com/apppasswords
SMTP_USER=bymap216@gmail.com
SMTP_PASS=shxj pzmc jyhn xoun

# --- Upload Médias (laisser vide = stockage local dans /uploads) --------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL de base du serveur (pour les URLs locales des médias)
BASE_URL=http://192.168.12.174:5000
